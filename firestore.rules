rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() && 
        exists(/databases/$(database)/documents/users/$(request.auth.uid)) &&
        (get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin' ||
         get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'super_admin');
    }
    
    // User accounts
    match /users/{userId} {
      allow read: if true;
      allow create: if isAuthenticated() && request.auth.uid == userId && 
        (!request.resource.data.keys().hasAny(['role']) || request.resource.data.role in ['user', 'business', 'professional', 'merchant']);
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (request.auth.uid == userId && 
          (!request.resource.data.diff(resource.data).affectedKeys().hasAny(['role']) || 
           request.resource.data.role in ['user', 'business', 'professional', 'merchant']) &&
          !request.resource.data.diff(resource.data).affectedKeys().hasAny(['isBanned'])
        )
      );
      allow delete: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      
      match /{subcollection=**} {
        allow read: if true;
        allow write: if isAuthenticated() && (request.auth.uid == userId || isAdmin());
      }
    }

    // Registered phone role exclusivity
    match /registered_phones/{phone} {
      allow read: if true;
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Payments audit records
    match /payments/{paymentId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && (request.resource.data.userId == request.auth.uid || isAdmin());
      allow update, delete: if isAdmin();
    }

    // Customer Leads (Justdial-style views, calls, inquiries)
    match /leads/{leadId} {
      allow read: if isAuthenticated() && (
        resource.data.targetOwnerUid == request.auth.uid ||
        resource.data.citizenUid == request.auth.uid ||
        isAdmin()
      );
      allow create: if request.resource.data.keys().hasAll(['targetId', 'targetType', 'actionType']);
      allow update, delete: if isAuthenticated() && (resource.data.targetOwnerUid == request.auth.uid || isAdmin());
    }
    
    // Businesses directory
    match /businesses/{businessId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.ownerUid == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['tier', 'verificationBadge', 'status']))
      );
      allow delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());

      match /reviews/{reviewId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }
    }

    // Skilled professionals
    match /professionals/{proId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update: if isAuthenticated() && (
        isAdmin() || 
        (resource.data.userId == request.auth.uid && !request.resource.data.diff(resource.data).affectedKeys().hasAny(['verifiedProfessional', 'status']))
      );
      allow delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
    }

    // Places and landmarks
    match /places/{placeId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // Places of worship
    match /places_of_worship/{worshipId} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // City events
    match /events/{eventId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.organizerUid == request.auth.uid || isAdmin());
    }

    // Offers and promotions
    match /promotions/{promoId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.ownerUid == request.auth.uid || isAdmin());
    }

    // Verification claims
    match /verification_requests/{reqId} {
      allow read: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      allow create: if isAuthenticated() && request.resource.data.userId == request.auth.uid;
      allow update, delete: if isAdmin();
    }

    // Moderation reports
    match /reports/{reportId} {
      allow create: if isAuthenticated();
      allow read, update, delete: if isAdmin();
    }

    // Existing social posts (backwards compatibility)
    match /posts/{postId} {
      allow read: if true;
      allow create: if isAuthenticated();
      allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      
      match /likes/{userId} {
        allow read: if true;
        allow write: if isAuthenticated() && request.auth.uid == userId;
      }

      match /comments/{commentId} {
        allow read: if true;
        allow create: if isAuthenticated();
        allow update, delete: if isAuthenticated() && (resource.data.userId == request.auth.uid || isAdmin());
      }

      match /reports/{userId} {
        allow create: if isAuthenticated() && request.auth.uid == userId;
        allow read, update, delete: if isAdmin();
      }
    }
    
    // Categories master list
    match /categories/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
    
    // Banners
    match /promotionBanners/{document=**} {
      allow read: if true;
      allow write: if isAdmin();
    }
  }
}
