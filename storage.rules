rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    
    function isAuthenticated() {
      return request.auth != null;
    }

    function isImageOrVideo() {
      return request.resource.contentType.matches('image/.*') || 
             request.resource.contentType.matches('video/.*');
    }

    function isValidSize() {
      return request.resource.size < 10 * 1024 * 1024; // 10MB limit
    }

    // Public read for all media
    match /{allPaths=**} {
      allow read: if true;
    }

    // User avatars
    match /avatars/{userId}/{fileName} {
      allow write: if isImageOrVideo() && isValidSize();
    }

    // Business media uploads (both 1-level and 2-level paths)
    match /businesses/{fileName} {
      allow write: if isImageOrVideo() && isValidSize();
    }
    match /businesses/{businessId}/{fileName} {
      allow write: if isImageOrVideo() && isValidSize();
    }

    // Professional media uploads
    match /professionals/{fileName} {
      allow write: if isImageOrVideo() && isValidSize();
    }
    match /professionals/{proId}/{fileName} {
      allow write: if isImageOrVideo() && isValidSize();
    }

    // Offers & hot deals
    match /offers/{fileName} {
      allow write: if isImageOrVideo() && isValidSize();
    }
    match /offers/{offerId}/{fileName} {
      allow write: if isImageOrVideo() && isValidSize();
    }

    // Marketplace / Bazaar items
    match /marketplace/{fileName} {
      allow write: if isImageOrVideo() && isValidSize();
    }
    match /marketplace/{itemId}/{fileName} {
      allow write: if isImageOrVideo() && isValidSize();
    }

    // Posts & general media
    match /posts/{userId}/{fileName} {
      allow write: if isImageOrVideo() && isValidSize();
    }

    // Admin banners
    match /banners/{fileName} {
      allow write: if isAuthenticated() && isImageOrVideo() && isValidSize();
    }
  }
}
